datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Company {
  id        String     @id @default(uuid())
  name      String
  industry  String
  email     String     @unique
  address   String
  phone     String
  createdAt DateTime   @default(now())
  users     User[]
  auditLogs AuditLog[]

  @@map("companies")
}

model User {
  id        String         @id @default(uuid())
  companyId String
  company   Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  email     String         @unique
  password  String
  role      String         @default("VIEWER") // "SUPER_ADMIN" | "COMPANY_ADMIN" | "ANALYST" | "VIEWER"
  status    String         @default("PENDING") // "ACTIVE" | "INACTIVE" | "PENDING"
  lastLogin DateTime?
  createdAt DateTime       @default(now())
  tokens    RefreshToken[]
  auditLogs AuditLog[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model AuditLog {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  ipAddress String
  browser   String
  timestamp DateTime @default(now())

  @@map("audit_logs")
}
